# ==========================================
# Application
# ==========================================
APP_NAME=Hotel Booking Backend
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
 
# ==========================================
# PostgreSQL
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=room_booking_db
DB_USERNAME=postgres

 
# Async URL (FastAPI)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/room_booking_db
 
# Sync URL (Alembic)
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/room_booking_db
 
DATABASE_ECHO=False
 
# ==========================================
# JWT
# ==========================================
SECRET_KEY=
ALGORITHM=HS256
 
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7